SHOULD_FAIL
CONFIG tools_calibrate.cfg
DICTIONARY stm32f407.dict

SHOW
TOOL_CALIBRATE_TOOL_OFFSET
TOOL_CALIBRATE_SAVE_TOOL_OFFSET
TOOL_CALIBRATE_QUERY_PROBE
TOOL_LOCATE_SENSOR
G28
G1 X100 Y100 Z10 F6000
TOOL_LOCATE_SENSOR
SHOW
G1 X102 Y99 Z10 F6000
TOOL_CALIBRATE_TOOL_OFFSET SAMPLES=1 SAMPLES_RESULT=average
SHOW
TOOL_CALIBRATE_SAVE_TOOL_OFFSET SECTION=tool1 ATTRIBUTE=offset
TOOL_CALIBRATE_SAVE_TOOL_OFFSET SECTION=tool1 ATTRIBUTE=off2 VALUE={x:.2f}/{y!r}/{z:>10.3e}
TOOL_CALIBRATE_SAVE_TOOL_OFFSET MACRO=TOOLVARS VARIABLE=offset
TOOLVARS
TOOL_CALIBRATE_QUERY_PROBE
TOOL_CALIBRATE_SAVE_TOOL_OFFSET SECTION=tool1 ATTRIBUTE=bad VALUE={w}
G4 P100

# webhooks subscriptions (API socket): a kaliru object and a python plugin's
# object; only changed fields are sent (Kalico compares with !=)
[mcu]
serial: {mcu}

[printer]
kinematics: none
max_velocity: 300
max_accel: 3000

[gcode_macro M]
variable_x: 1
variable_lst: [1, 2]
gcode:
  M117 hi

[kaliru_test_plugin]
value: 2.5
label: one

---
@api objects/query {"objects": {"kaliru_test_plugin": null, "gcode_macro M": null}}
@sub {"kaliru_test_plugin": null, "gcode_macro M": ["x", "lst"], "print_stats": ["state"]}
@notify 1.0
TEST_PLUGIN_SET LABEL=two
@notify 1.0
TEST_PLUGIN_SET V=3.75
@notify 1.0
SET_GCODE_VARIABLE MACRO=M VARIABLE=x VALUE=5
@notify 1.0
TEST_PLUGIN_SET LABEL=two V=3.75
@notify 1.0
SET_GCODE_VARIABLE MACRO=M VARIABLE=lst VALUE="[1, 2, 3]"
@notify 1.0

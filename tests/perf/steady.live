# Resource gate workload (tools/resource_gate.sh): a cartesian printer with
# heaters and fans, every object subscribed (as a Mainsail tab), idling
[mcu]
serial: {mcu}

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000
max_z_velocity: 5
max_z_accel: 100

[stepper_x]
step_pin: gpio2
dir_pin: gpio3
enable_pin: !gpio4
microsteps: 16
rotation_distance: 40
endstop_pin: ^gpio5
position_endstop: 0
position_max: 200
homing_speed: 50

[stepper_y]
step_pin: gpio6
dir_pin: gpio7
enable_pin: !gpio8
microsteps: 16
rotation_distance: 40
endstop_pin: ^gpio9
position_endstop: 0
position_max: 200
homing_speed: 50

[stepper_z]
step_pin: gpio10
dir_pin: gpio11
enable_pin: !gpio12
microsteps: 16
rotation_distance: 8
endstop_pin: ^gpio13
position_endstop: 0
position_max: 200

[extruder]
step_pin: gpio14
dir_pin: gpio15
enable_pin: !gpio16
microsteps: 16
rotation_distance: 33.5
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: gpio17
sensor_type: EPCOS 100K B57560G104F
sensor_pin: analog0
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: 0
max_temp: 250

[fan]
pin: gpio18
[heater_bed]
heater_pin: gpio19
sensor_type: EPCOS 100K B57560G104F
sensor_pin: analog1
control: watermark
min_temp: 0
max_temp: 130

[heater_fan hotend_fan]
pin: gpio20
heater: extruder

[idle_timeout]

[pause_resume]

[display_status]

[virtual_sdcard]
path: /tmp/kaliru_perf_sd

[gcode_macro PRINT_START]
variable_count: 0
gcode:
  SET_GCODE_VARIABLE MACRO=PRINT_START VARIABLE=count VALUE={printer["gcode_macro PRINT_START"].count + 1}
---
M104 S200
M140 S60
@sub {"gcode": null, "webhooks": null, "configfile": null, "mcu": null, "heaters": null, "toolhead": null, "gcode_move": null, "extruder": null, "heater_bed": null, "fan": null, "heater_fan hotend_fan": null, "idle_timeout": null, "pause_resume": null, "display_status": null, "virtual_sdcard": null, "print_stats": null, "gcode_macro PRINT_START": null, "motion_report": null, "query_endstops": null, "system_stats": null, "stepper_enable": null}
@notify 60

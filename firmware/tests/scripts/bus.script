# spi and i2c buses (fake devices), sensors on them, adc
allocate_oids count=16
config_spi oid=0 pin=gpio50 cs_active_high=0
spi_set_bus oid=0 spi_bus=spidev0.0 mode=3 rate=4000000
config_thermocouple oid=1 spi_oid=0 thermocouple_type=MAX31855
config_spi oid=2 pin=gpio51 cs_active_high=1
spi_set_bus oid=2 spi_bus=spidev1.0 mode=0 rate=1000000
config_adxl345 oid=3 spi_oid=2
config_i2c oid=4
i2c_set_bus oid=4 i2c_bus=i2c.1 rate=400000 address=104
config_mpu9250 oid=5 i2c_oid=4
config_i2c oid=6
i2c_set_bus oid=6 i2c_bus=i2c.1 rate=400000 address=42
config_ldc1612 oid=7 i2c_oid=6
config_analog_in oid=8 pin=analog2
config_spi oid=9 pin=gpio52 cs_active_high=0
spi_set_sw_bus oid=9 miso_pin=gpio53 mosi_pin=gpio54 sclk_pin=gpio55 mode=0 pulse_ticks=10
finalize_config crc=11
spi_transfer oid=0 data=01020304
spi_send oid=2 data=aabb
i2c_write oid=4 data=6b00
i2c_read oid=4 reg=75 read_len=2
spi_transfer oid=9 data=c3
query_adxl345_status oid=3
query_mpu9250_status oid=5
query_status_ldc1612 oid=7
get_clock
query_thermocouple oid=1 clock={clock+50000000} rest_ticks=2500000 min_value=0 max_value=4294967295 max_invalid_count=0
query_analog_in oid=8 clock={clock+50000000} sample_ticks=10000 sample_count=4 rest_ticks=5000000 min_value=0 max_value=4095 range_check_count=0
#wait 1.5
query_thermocouple oid=1 clock=0 rest_ticks=0 min_value=0 max_value=0 max_invalid_count=0
query_analog_in oid=8 clock=0 sample_ticks=0 sample_count=0 rest_ticks=0 min_value=0 max_value=0 range_check_count=0
#wait 0.1
emergency_stop

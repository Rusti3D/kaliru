# tmcuart, neopixel, pulse counter, lcds, bit-banged adcs, bulk sensors, load cell probe
allocate_oids count=24
config_tmcuart oid=0 rx_pin=gpio60 pull_up=1 tx_pin=gpio61 bit_time=4000
config_neopixel oid=1 pin=gpio62 data_size=6 bit_max_ticks=1000000 reset_min_ticks=1000
config_counter oid=2 pin=gpio63 pull_up=0
config_st7920 oid=3 cs_pin=gpio64 sclk_pin=gpio65 sid_pin=gpio66 sync_delay_ticks=100 cmd_delay_ticks=100
config_hd44780 oid=4 rs_pin=gpio67 e_pin=gpio68 d4_pin=gpio69 d5_pin=gpio70 d6_pin=gpio71 d7_pin=gpio72 delay_ticks=100
config_hx71x oid=5 gain_channel=1 dout_pin=gpio73 sclk_pin=gpio74
config_cs1237 oid=6 config=12 dout_pin=gpio75 sclk_pin=gpio76
config_spi oid=7 pin=gpio77 cs_active_high=0
spi_set_bus oid=7 spi_bus=spidev2.0 mode=1 rate=2000000
config_ads1220 oid=8 spi_oid=7 data_ready_pin=gpio78
config_spi oid=9 pin=gpio79 cs_active_high=0
spi_set_bus oid=9 spi_bus=spidev3.0 mode=1 rate=2000000
config_ads131m0x oid=10 spi_oid=9 data_ready_pin=gpio80 sensor_channel_count=2 channel_mask=3
config_i2c oid=11
i2c_set_bus oid=11 i2c_bus=i2c.2 rate=400000 address=24
config_lis2dw oid=12 bus_oid=11 bus_oid_type=i2c lis_chip_type=LIS3DH
config_i2c oid=13
i2c_set_bus oid=13 i2c_bus=i2c.2 rate=400000 address=105
config_icm20948 oid=14 i2c_oid=13
config_trsync oid=15
config_sos_filter oid=16 max_sections=2
config_load_cell_probe oid=17 sos_filter_oid=16
hx71x_attach_load_cell_probe oid=5 load_cell_probe_oid=17
finalize_config crc=21
get_config
tmcuart_send oid=0 write=05ff0016 read=0
neopixel_update oid=1 pos=0 data=ff0080
neopixel_send oid=1
st7920_send_cmds oid=3 cmds=0c30
st7920_send_data oid=3 data=41
hd44780_send_cmds oid=4 cmds=28
hd44780_send_data oid=4 data=42
query_lis2dw_status oid=12
query_icm20948_status oid=14
query_hx71x_status oid=5
query_cs1237_status oid=6
query_ads1220_status oid=8
query_ads131m0x_status oid=10
sos_filter_set_section oid=16 section_idx=0 sos0=1073741824 sos1=0 sos2=0 sos3=0 sos4=0
sos_filter_set_active oid=16 n_sections=1 coeff_int_bits=1
load_cell_probe_set_range oid=17 safety_counts_min=-100000000 safety_counts_max=100000000 tare_counts=0 trigger_grams=1000 grams_per_count=268435456
get_clock
trsync_start oid=15 report_clock={clock+200000000} report_ticks=0 expire_reason=4
load_cell_probe_home oid=17 trsync_oid=15 trigger_reason=1 error_reason=2 clock={clock+50000000} rest_ticks=5000000 timeout=10
query_counter oid=2 clock={clock+50000000} poll_ticks=500000 sample_ticks=10000000
query_hx71x oid=5 rest_ticks=2000000
#wait 1.4
query_hx71x oid=5 rest_ticks=0
query_counter oid=2 clock=0 poll_ticks=0 sample_ticks=0
load_cell_probe_query_state oid=17
#wait 0.2
emergency_stop
